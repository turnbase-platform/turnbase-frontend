# Rendered at container start by the nginx image's envsubst step (only TURNBASE_* variables are
# substituted — see NGINX_ENVSUBST_FILTER in the Dockerfile). The variables come from
# 15-derive-origins.envsh; the deployment sets the three it reads.
#
# This container is the listener on the platform origin (local-environment.md §1): the shell, its
# Content-Security-Policy, and a reverse proxy to the monolith. Everything that is not the
# platform host falls through to the monolith, which routes the games origin by Host.

# WebSocket upgrade: `close` when the client did not ask for one.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# IMP-M18-09 (load-testing-phase-b.md §4.3): `/ws?instance={podId}` names the pod that owns the room.
# The hint is `<name>@<a-b-c-d>:<uuid>` (room-lifecycle.md §1.1; a-b-c-d is the pod's address with
# dashes). A ready pod of the platform's headless Service resolves as `a-b-c-d.<headless domain>`; a
# pod that is not ready, or gone, does not. Empty when there is no hint or it is not shaped like one,
# and then the upgrade goes to the regular Service. Only the dashed address is taken from the
# parameter, so it can name nothing but an endpoint of that Service.
map $arg_instance $ws_pod {
  default '';
  # `$arg_*` is not URL-decoded and the browser's encodeURIComponent turns `@` and `:` into %40 and %3A,
  # so both spellings match. Quoted: nginx reads an unquoted `{` as the start of a block.
  "~^[^@:%]*(?:@|%40)(?<hinted_pod>[0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3})(?::|%3[Aa])" $hinted_pod;
}

# The resolver is the container's own (15-derive-origins.envsh). Short TTL: a replaced pod must stop
# resolving within seconds, and a failed lookup falls back to the Service anyway.
resolver ${TURNBASE_DNS_RESOLVER} valid=5s ipv6=off;

# IMP-M10-18: the Hosts the fall-through may serve — the games origin, as derived by
# 15-derive-origins.envsh. The platform host has its own server below.
map $host $known_game_host {
  default 0;
  ~*^${TURNBASE_GAME_HOST_REGEX}$ 1;
}

# HSTS only when the request reached the edge over TLS (a terminator in front sets the header).
# An empty value makes `add_header` omit the header.
map $http_x_forwarded_proto $hsts {
  default '';
  https   'max-age=31536000; includeSubDomains';
}

# Fall-through: a Host in the games origin (in practice *.games.localhost) goes to the monolith
# untouched, so the wildcard is never enumerated here. Any other Host is not ours: 421.
server {
  listen 8080 default_server;
  server_name _;

  if ($known_game_host = 0) {
    return 421;
  }

  # IMP-M10-06: GameHostRegistryService shares the monolith's listener (local-environment.md §7.8), so
  # unreachability from the public edge IS its access control. Refused here, ahead of the proxy.
  location ^~ /turnbase.gamehost.v1. {
    return 404;
  }

  location / {
    proxy_pass http://${TURNBASE_FRONTEND_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
  }
}

server {
  listen 8080;
  server_name ${TURNBASE_PLATFORM_HOST};

  root /usr/share/nginx/html;
  index index.html;

  # Nothing here adds authorization: the monolith's Origin and session checks are unchanged.
  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-Host $http_host;

  # IMP-M10-06: GameHostRegistryService shares the monolith's listener (local-environment.md §7.8), so
  # unreachability from the public edge IS its access control. Refused here, ahead of the proxy.
  location ^~ /turnbase.gamehost.v1. {
    return 404;
  }

  location /api/ {
    proxy_pass http://${TURNBASE_FRONTEND_UPSTREAM};
  }

  # sse-notifications.md: a long-lived text/event-stream. Buffered, nothing reaches the browser
  # until the buffer fills; the 30 s keepalive comment stays inside the read timeout.
  location = /api/notifications/stream {
    proxy_pass http://${TURNBASE_FRONTEND_UPSTREAM};
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  # `proxy_set_header` is inherited only by a location that sets none of its own, so this one
  # repeats the server-level four alongside the two upgrade headers.
  #
  # IMP-M18-09: with an instance hint the upgrade goes to that pod through the headless Service. No
  # hint (418, internal), a name that does not resolve or a refused connection (502/504) falls back
  # to the regular Service in @ws_service: the hint is advisory (FR-DEPLOY-002). The pod is the
  # target, not a hash of the room (ADR-0008).
  location /ws {
    error_page 418 502 504 = @ws_service;
    if ($ws_pod = '') {
      return 418;
    }
    proxy_pass http://$ws_pod.${TURNBASE_PLATFORM_PODS_DOMAIN}:${TURNBASE_PLATFORM_PORT};
    proxy_connect_timeout 2s;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 1h;
  }

  location @ws_service {
    proxy_pass http://${TURNBASE_FRONTEND_UPSTREAM};
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 1h;
  }

  # Exactly these two, and no `/auth/` prefix: /auth/complete-registration is a shell route
  # (oauth-rest-api.md §4 redirects the browser to it) and must reach the SPA fallback below
  # (IMP-GATE-76).
  location = /auth/google {
    proxy_pass http://${TURNBASE_FRONTEND_UPSTREAM};
  }

  location = /auth/callback {
    proxy_pass http://${TURNBASE_FRONTEND_UPSTREAM};
  }

  # IMP-M10-18: `add_header` is inherited only by a location that sets none of its own, so the four
  # hardening headers repeat beside the CSP below. X-Frame-Options mirrors `frame-ancestors 'none'`:
  # the shell is never framed (games are framed by it, not the reverse).
  # The shell. `frame-src` is derived by 15-derive-origins.envsh and owned by
  # game-asset-serving.md §6.3; everything else is shell-architecture.md §6. `always` puts the
  # header on error responses too.
  set $shell_csp "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-src ${TURNBASE_FRAME_SRC}; frame-ancestors 'none'; form-action 'self'; base-uri 'none'; object-src 'none'";

  # IMP-M10-17: the SPA fallback is for the shell's own routes only (src/app/routes.tsx — keep the
  # two in step). Any other path is a 404 that still carries index.html, so the shell renders its 404
  # view (VW-404-001) under the right status. /auth/ is not a prefix here: only complete-registration
  # is a shell route (IMP-GATE-76).
  location ~ ^/(login|register|auth/complete-registration|games(/[^/]+)?|users/[^/]+|rooms(/.*)?|friends|settings)?/?$ {
    try_files /index.html =404;
    add_header Content-Security-Policy $shell_csp always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Strict-Transport-Security $hsts always;
  }

  # Real static assets; a miss is a 404 with the shell as the body.
  location / {
    try_files $uri =404;
    error_page 404 /index.html;
    add_header Content-Security-Policy $shell_csp always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Strict-Transport-Security $hsts always;
  }
}
