{
  "name": "turnbase-frontend",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "vite",
    "theme:build": "npm run astryx -- theme build src/theme/turnbase.theme.ts --icons-specifier @astryxdesign/theme-neutral",
    "theme:check": "npm run astryx -- theme build src/theme/turnbase.theme.ts --icons-specifier @astryxdesign/theme-neutral --check",
    "build": "npm run theme:build && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src e2e vite.config.ts playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.5.2",
    "@astryxdesign/theme-neutral": "0.5.2",
    "@fontsource/figtree": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@stomp/stompjs": "7.3.0",
    "@stylexjs/stylex": "0.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.5.2",
    "@eslint/css": "2.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "axe-core": "4.10.3",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
